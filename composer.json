{
    "name": "a35g/json-to-xml",
    "description": "Lightweight PHP JSON <-> XML converter with attributes, mixed content, automatic CDATA, repeated elements and XXE-safe parsing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "composer",
        "json",
        "xml",
        "json-to-xml",
        "xml-to-json",
        "converter",
        "cdata",
        "mixed-content",
        "xml-attributes",
        "dom",
        "xxe-protection"
    ],
    "authors": [
        {
            "name": "A35G"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "A35G\\JsonToXml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "A35G\\JsonToXml\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/json-to-xml"
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@analyse",
            "@cs",
            "@test"
        ]
    }
}