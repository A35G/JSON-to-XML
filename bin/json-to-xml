#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadFile = null;
foreach (
    [
        $GLOBALS['_composer_autoload_path'] ?? null, // impostato da Composer per vendor/bin
        __DIR__ . '/../vendor/autoload.php',         // checkout del repository
        __DIR__ . '/../../../autoload.php',          // installato come dipendenza
    ] as $candidate
) {
    if (is_string($candidate) && is_file($candidate)) {
        $autoloadFile = $candidate;
        break;
    }
}

if ($autoloadFile === null) {
    fwrite(STDERR, "Impossibile trovare l'autoloader di Composer: eseguire 'composer install'.\n");
    exit(1);
}

require $autoloadFile;

use A35G\JsonToXml\JsonToXmlConverter;
use A35G\JsonToXml\XmlToJsonConverter;

/** Limite di default per la CLI: 16 MiB. Disattivabile con --max-bytes=0. */
const DEFAULT_MAX_BYTES = 16777216;

/**
 * CLI per la libreria json-to-xml.
 *
 * Uso:
 *   json-to-xml to-xml  [--input=file.json] [--output=file.xml] [--root=data] [--item=item] [--no-cdata]
 *                       [--stylesheet=style.xsl] [--stylesheet-type=text/xsl] [--max-bytes=N]
 *   json-to-xml to-json [--input=file.xml]  [--output=file.json] [--force-array=Tag1,Tag2] [--max-bytes=N] 
 *                       [--allow-doctype]
 *
 * Se --input è omesso, legge da STDIN. Se --output è omesso, scrive su STDOUT.
 * 
 * --max-bytes=N  Dimensione massima dell'input in byte (default 16777216, 0 = nessun limite).
 * --allow-doctype  to-json: accetta XML con DOCTYPE (rifiutato per default: usalo solo con input fidato).
 *
 * Codici di uscita:
 *   0 = successo
 *   1 = uso non valido / comando sconosciuto
 *   2 = errore di I/O (file non leggibile/scrivibile)
 *   3 = InvalidArgumentException (JSON/XML non valido, dati non validi)
 *   4 = RuntimeException (errore interno di conversione)
 */
function printUsage(): void
{
    fwrite(STDERR, <<<TXT
Uso:
  json-to-xml to-xml  [--input=file.json] [--output=file.xml] [--root=data] [--item=item] [--no-cdata]
                      [--stylesheet=style.xsl] [--stylesheet-type=text/xsl] [--max-bytes=N]
  json-to-xml to-json [--input=file.xml]  [--output=file.json] [--force-array=Tag1,Tag2] [--max-bytes=N]
                      [--allow-doctype]

Se --input è omesso, legge da STDIN. Se --output è omesso, scrive su STDOUT.

--max-bytes=N  Dimensione massima dell'input in byte (default 16777216, 0 = nessun limite).
--allow-doctype  to-json: accetta XML con DOCTYPE (rifiutato per default: usalo solo con input fidato).

TXT);
}

function printUsageAndExit(int $exitCode): never
{
    printUsage();
    exit($exitCode);
}

/**
 * @param string[] $args
 * @return array{0: string[], 1: array<string, string|bool>}
 */
function parseArgs(array $args): array
{
    $positional = [];
    $options = [];

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--')) {
            $body = substr($arg, 2);
            if (str_contains($body, '=')) {
                [$name, $value] = explode('=', $body, 2);
                $options[$name] = $value;
            } else {
                $options[$body] = true;
            }
            continue;
        }

        $positional[] = $arg;
    }

    return [$positional, $options];
}

/**
 * @param array<string, string|bool> $options
 */
function resolveMaxBytes(array $options): ?int
{
    if (!isset($options['max-bytes'])) {
        return DEFAULT_MAX_BYTES;
    }

    $raw = $options['max-bytes'];
    $value = is_string($raw)
        ? filter_var($raw, FILTER_VALIDATE_INT, ['options' => ['min_range' => 0, 'max_range' => PHP_INT_MAX - 1]])
        : false;

    if ($value === false) {
        fwrite(STDERR, "Valore non valido per --max-bytes (atteso un intero >= 0).\n");
        exit(1);
    }

    return $value === 0 ? null : $value;
}

/**
 * @param array<string, string|bool> $options
 */
function readInput(array $options, ?int $maxBytes): string
{
    // Si legge un byte in più del limite: basta alla classe per rifiutare
    // l'input, senza mai caricare in memoria uno stream illimitato.
    // $maxBytes proviene da resolveMaxBytes(), che garantisce 1 <= valore <= PHP_INT_MAX - 1.
    /** @var int<0, max>|null $limit */
    $limit = $maxBytes === null ? null : $maxBytes + 1;

    if (isset($options['input']) && is_string($options['input'])) {
        $path = $options['input'];
        if (!is_readable($path)) {
            fwrite(STDERR, "Impossibile leggere il file di input: {$path}\n");
            exit(2);
        }

        return (string) file_get_contents($path, false, null, 0, $limit);
    }

    $content = stream_get_contents(STDIN, $limit);

    return $content === false ? '' : $content;
}

/**
 * @param array<string, string|bool> $options
 */
function writeOutput(string $content, array $options): void
{
    if (isset($options['output']) && is_string($options['output'])) {
        $path = $options['output'];
        if (file_put_contents($path, $content) === false) {
            fwrite(STDERR, "Impossibile scrivere il file di output: {$path}\n");
            exit(2);
        }

        return;
    }

    fwrite(STDOUT, $content);
}

/** @var string[] $argv */
$scriptName = array_shift($argv);
[$positional, $options] = parseArgs($argv);

if (isset($options['help'])) {
    printUsageAndExit(0);
}

if ($positional === []) {
    printUsageAndExit(1);
}

$command = $positional[0];

try {

    $maxBytes = resolveMaxBytes($options);

    switch ($command) {
        case 'to-xml':
            $root = is_string($options['root'] ?? null) ? $options['root'] : 'data';
            $item = is_string($options['item'] ?? null) ? $options['item'] : 'item';
            $useCdata = !isset($options['no-cdata']);

            $converter = new JsonToXmlConverter($root, $item, $useCdata, $maxBytes);

            if (isset($options['stylesheet']) && is_string($options['stylesheet'])) {
                $stylesheetType = is_string($options['stylesheet-type'] ?? null)
                    ? $options['stylesheet-type']
                    : 'text/xsl';

                $converter->setStylesheet($options['stylesheet'], $stylesheetType);
            }

            $output = $converter->jsonToXmlString(readInput($options, $maxBytes));
            writeOutput($output, $options);
            break;

        case 'to-json':
            $forceArrayTags = [];
            if (isset($options['force-array']) && is_string($options['force-array'])) {
                $forceArrayTags = array_values(array_filter(array_map('trim', explode(',', $options['force-array']))));
            }

            $converter = new XmlToJsonConverter($forceArrayTags, $maxBytes, isset($options['allow-doctype']));
            $output = $converter->xmlToJsonString(readInput($options, $maxBytes));
            writeOutput($output, $options);
            break;

        default:
            fwrite(STDERR, "Comando sconosciuto: {$command}\n");
            printUsageAndExit(1);
    }
} catch (InvalidArgumentException $e) {
    fwrite(STDERR, 'Errore: ' . $e->getMessage() . "\n");
    exit(3);
} catch (RuntimeException $e) {
    fwrite(STDERR, 'Errore: ' . $e->getMessage() . "\n");
    exit(4);
}

exit(0);
